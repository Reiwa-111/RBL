# Merge sort, heap sort, quick sort and binary search.
# All algorithms sort in place and print results directly to the terminal.

func merge(values list, temporary list, left int, middle int, right int) (
    set i = left
    set j = middle + 1
    set k = left

    for (i <= middle and j <= right) (
        if (values[i] <= values[j]) (
            let temporary[k] = values[i]
            let i += 1
        ) else (
            let temporary[k] = values[j]
            let j += 1
        )
        let k += 1
    )
    for (i <= middle) (
        let temporary[k] = values[i]
        let i += 1
        let k += 1
    )
    for (j <= right) (
        let temporary[k] = values[j]
        let j += 1
        let k += 1
    )
    for (copy_index in left..=right) (
        let values[copy_index] = temporary[copy_index]
    )
)

func merge_sort(values list, temporary list, left int, right int) (
    if (left < right) (
        set middle = (left + right) / 2
        merge_sort(values, temporary, left, middle)
        merge_sort(values, temporary, middle + 1, right)
        merge(values, temporary, left, middle, right)
    )
)

func sift_down(values list, root int, end int) (
    set current = root
    set child = 0
    set swap_index = 0
    set temporary = 0
    for (true) (
        let child = current * 2 + 1
        if (child > end) ( break )
        let swap_index = current
        if (values[swap_index] < values[child]) (
            let swap_index = child
        )
        if (child + 1 <= end) (
            if (values[swap_index] < values[child + 1]) (
                let swap_index = child + 1
            )
        )
        if (swap_index == current) ( break )
        let temporary = values[current]
        let values[current] = values[swap_index]
        let values[swap_index] = temporary
        let current = swap_index
    )
)

func heap_sort(values list) (
    set count = len(values)
    set root = 0
    set end = 0
    set temporary = 0
    for (offset in 0..(count / 2)) (
        let root = count / 2 - 1 - offset
        sift_down(values, root, count - 1)
    )
    let end = count - 1
    for (end > 0) (
        let temporary = values[0]
        let values[0] = values[end]
        let values[end] = temporary
        let end -= 1
        sift_down(values, 0, end)
    )
)

func partition(values list, low int, high int) int (
    set pivot = values[high]
    set boundary = low
    set temporary = 0
    for (scan in low..high) (
        if (values[scan] <= pivot) (
            let temporary = values[boundary]
            let values[boundary] = values[scan]
            let values[scan] = temporary
            let boundary += 1
        )
    )
    let temporary = values[boundary]
    let values[boundary] = values[high]
    let values[high] = temporary
    return boundary
)

func quick_sort(values list, low int, high int) (
    if (low < high) (
        set pivot_index = partition(values, low, high)
        if (pivot_index > low) (
            quick_sort(values, low, pivot_index - 1)
        )
        if (pivot_index < high) (
            quick_sort(values, pivot_index + 1, high)
        )
    )
)

func is_sorted(values list) bool (
    for (i in 1..len(values)) (
        if (values[i - 1] > values[i]) (
            return false
        )
    )
    return true
)

func binary_search(values list, target int) int (
    set low = 0
    set high = len(values) - 1
    set middle = 0
    for (low <= high) (
        let middle = (low + high) / 2
        if (values[middle] == target) (
            return middle
        ) elif (values[middle] < target) (
            let low = middle + 1
        ) else (
            let high = middle - 1
        )
    )
    return -1
)

func main() (
    set source = [42, 7, 19, -4, 0, 19, 88, 3, 51, 12, -9, 27]
    set merged = [42, 7, 19, -4, 0, 19, 88, 3, 51, 12, -9, 27]
    set heap = [42, 7, 19, -4, 0, 19, 88, 3, 51, 12, -9, 27]
    set quick = [42, 7, 19, -4, 0, 19, 88, 3, 51, 12, -9, 27]
    set temporary = []
    for (i in 0..len(source)) (
        let temporary = list_push(temporary, 0)
    )

    print("SORTING AND SEARCHING — RBL")
    print("input:", source)

    merge_sort(merged, temporary, 0, len(merged) - 1)
    heap_sort(heap)
    quick_sort(quick, 0, len(quick) - 1)

    print("merge sort:", merged, "valid:", is_sorted(merged))
    print("heap sort :", heap, "valid:", is_sorted(heap))
    print("quick sort:", quick, "valid:", is_sorted(quick))
    print("binary search 19 -> index", binary_search(merged, 19))
    print("binary search 100 -> index", binary_search(merged, 100))
)
