# 64x64 random grayscale image as portable graymap (P2).
# This is visual noise, not a cryptographically secure random source.

func main() (
    set width = 64
    set height = 64
    print("P2")
    print(f"{width} {height}")
    print("255")

    for (y in 0..height) (
        for (x in 0..width) (
            print(random_int(0, 255))
        )
    )
)
