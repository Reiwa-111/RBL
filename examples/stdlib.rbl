// Standard library showcase
func main() (
    print("len:", len("Привет"))
    print("abs:", abs(-42))
    print("sqrt:", sqrt(81))
    print("min:", min(9, 4, 7))
    print("max:", max(9, 4, 7))
    print("int:", int("123"))
    print("float:", float("3.25"))
    print("str:", str(456))
    set path = "rbl_example.txt"
    write_file(path, "Hello from RBL")
    print(read_file(path))
    rbl.fs.delete(path)
)
