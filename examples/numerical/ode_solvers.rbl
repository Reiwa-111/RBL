# Numerical ODE examples using classical fourth-order Runge-Kutta (RK4).
# 1) Harmonic oscillator: x'' + omega^2*x = 0.
# 2) Logistic growth: y' = r*y*(1-y/K).

func oscillator_derivative(position float, velocity float, omega float) (
    return (velocity, -omega * omega * position)
)

func logistic_derivative(population float, rate float, capacity float) float (
    return rate * population * (1.0 - population / capacity)
)

func rk4_oscillator_step(position float, velocity float, omega float, dt float) (
    set k1 = oscillator_derivative(position, velocity, omega)
    set k2 = oscillator_derivative(position + 0.5 * dt * k1[0], velocity + 0.5 * dt * k1[1], omega)
    set k3 = oscillator_derivative(position + 0.5 * dt * k2[0], velocity + 0.5 * dt * k2[1], omega)
    set k4 = oscillator_derivative(position + dt * k3[0], velocity + dt * k3[1], omega)
    set next_position = position + (dt / 6.0) * (k1[0] + 2.0 * k2[0] + 2.0 * k3[0] + k4[0])
    set next_velocity = velocity + (dt / 6.0) * (k1[1] + 2.0 * k2[1] + 2.0 * k3[1] + k4[1])
    return (next_position, next_velocity)
)

func rk4_logistic_step(population float, rate float, capacity float, dt float) float (
    set k1 = logistic_derivative(population, rate, capacity)
    set k2 = logistic_derivative(population + 0.5 * dt * k1, rate, capacity)
    set k3 = logistic_derivative(population + 0.5 * dt * k2, rate, capacity)
    set k4 = logistic_derivative(population + dt * k3, rate, capacity)
    return population + (dt / 6.0) * (k1 + 2.0 * k2 + 2.0 * k3 + k4)
)

func main() (
    set omega = 2.0
    set dt = 0.01
    set steps = 200
    set position = 1.0
    set velocity = 0.0
    set k1 = ()
    set k2 = ()
    set k3 = ()
    set k4 = ()
    set next_state = ()
    set time_value = 0.0

    print("HARMONIC OSCILLATOR — RK4")
    print("time,position,velocity,total_energy")
    for (step in 0..=steps) (
        if (step % 10 == 0) (
            let time_value = float(step) * dt
            print(f"{time_value},{position},{velocity},{0.5 * (velocity * velocity + omega * omega * position * position)}")
        )
        if (step < steps) (
            let next_state = rk4_oscillator_step(position, velocity, omega, dt)
            let position = next_state[0]
            let velocity = next_state[1]
        )
    )

    set rate = 1.2
    set capacity = 1000.0
    set population = 25.0
    print("LOGISTIC GROWTH — RK4")
    print("time,population")
    for (step in 0..=100) (
        if (step % 10 == 0) (
            print(f"{float(step) * 0.05},{population}")
        )
        if (step < 100) (
            let population = rk4_logistic_step(population, rate, capacity, 0.05)
        )
    )
)
