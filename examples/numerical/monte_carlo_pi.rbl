# Monte Carlo estimate of pi using uniformly sampled points in the unit square.
# The estimate is stochastic and will differ between runs and platforms.

func main() (
    set samples = 50000
    set inside = 0
    set x = 0.0
    set y = 0.0
    set radius_squared = 0.0
    set estimate = 0.0
    set probability = 0.0
    set standard_error = 0.0

    print("MONTE CARLO ESTIMATION OF PI")
    print(f"samples: {samples}")
    print("samples,inside,pi_estimate,approx_standard_error")
    for (sample in 1..=samples) (
        let x = random_float()
        let y = random_float()
        let radius_squared = x * x + y * y
        if (radius_squared <= 1.0) (
            let inside += 1
        )
        if (sample % 5000 == 0) (
            let probability = float(inside) / float(sample)
            let estimate = 4.0 * probability
            let standard_error = 4.0 * sqrt(probability * (1.0 - probability) / float(sample))
            print(f"{sample},{inside},{estimate:.6f},{standard_error:.6f}")
        )
    )
    print(f"reference pi: {rbl.math.pi:.10f}")
    print(f"absolute error: {abs(estimate - rbl.math.pi):.6f}")
    print("The standard error is an approximation based on Bernoulli sampling.")
)
