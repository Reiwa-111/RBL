# Renders one 640x432 tile of a 3840x2160 Mandelbrot image.
# Read two stdin lines: x offset, then y offset. Output is a PGM P2 tile.

func mandelbrot(real float, imaginary float, max_iterations int) int (
    set zr = 0.0
    set zi = 0.0
    set iteration = 0
    set zr_squared = 0.0
    set zi_squared = 0.0
    set next_zi = 0.0
    for (iteration < max_iterations) (
        let zr_squared = zr * zr
        let zi_squared = zi * zi
        if (zr_squared + zi_squared > 4.0) (
            return iteration
        )
        let next_zi = 2.0 * zr * zi + imaginary
        let zr = zr_squared - zi_squared + real
        let zi = next_zi
        let iteration += 1
    )
    return max_iterations
)

func main() (
    set full_width = 3840
    set full_height = 2160
    set tile_width = 640
    set tile_height = 432
    set x_offset = int(input())
    set y_offset = int(input())
    set max_iterations = 96
    set global_x = 0
    set global_y = 0
    set real = 0.0
    set imaginary = 0.0
    set iteration = 0
    set value = 0

    if (x_offset < 0 or x_offset + tile_width > full_width or y_offset < 0 or y_offset + tile_height > full_height) (
        return
    )

    print("P2")
    print(f"{tile_width} {tile_height}")
    print("255")
    for (y in 0..tile_height) (
        for (x in 0..tile_width) (
            let global_x = x + x_offset
            let global_y = y + y_offset
            let real = -2.25 + (float(global_x) / float(full_width - 1)) * 3.0
            let imaginary = 1.35 - (float(global_y) / float(full_height - 1)) * 2.7
            let iteration = mandelbrot(real, imaginary, max_iterations)
            let value = 0
            if (iteration < max_iterations) (
                let value = 255 - int((float(iteration) / float(max_iterations)) * 255.0)
            )
            print(value)
        )
    )
)
