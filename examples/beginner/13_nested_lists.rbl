// Lesson 13: lists can contain other lists. Index each level separately.
func main() (
    set grid = [
        [1, 2, 3],
        [4, 5, 6],
        [7, 8, 9]
    ]

    print("Middle cell:", grid[1][1])
    // Bind the inner list to a variable, then update that list's element.
    set first_row = grid[0]
    let first_row[2] = 30
    print("Updated first row:", grid[0])

    for (row in grid) (
        for (value in row) (
            print(value)
        )
    )
)
