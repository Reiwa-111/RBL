    "app_local_runtime": "3.14.10",
    "note": "End users use the bundled runtime; a system Python is not required for installed execution."
  },
  "prebuilt_policy": {
    "repository_contains_maintainer_build_toolchain": false,
    "repository_contains_prebuilt_product": true,
    "repository_contains_user_program_backend": true,
    "distribution_contains_prebuilt_user_program_backend": true,
    "distribution_requires_external_maintainer_compiler": false,
    "clean_user_rbl_compilation_requires_external_toolchain": false,
    "assembly_rule": "Explicit installer allowlist only; never archive a CMake/wxWidgets build tree.",
    "portable_staging": "install_windows.ps1 -Portable and install_linux.sh --portable omit the install manifest, uninstaller and registry/XDG integration so archives contain no machine-specific state.",
    "release_packaging": "tools/package_release.py validates a portable staging tree and writes the archive, SHA256SUMS, per-archive JSON metadata and a LOCAL_CANDIDATE note. It never publishes or uploads.",
    "windows_user_program_backend": "toolchain/windows-x86_64 contains a 43-file pruned MinGW runtime bundle (44 files on disk including its manifest; 47 tracked files including notices/audits) used to assemble/link RBL programs in a source checkout and staged into the prebuilt Windows app. It is not sufficient to rebuild RBL Studio itself; full MSYS2/CMake/Rust/wx build dependencies remain external. Keep this separate from maintainer build requirements until a replacement passes clean-install compile acceptance."
  }
