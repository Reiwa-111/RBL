{
  "schema": "rbl-toolchain-requirements/1",
  "project": "RBL Studio",
  "version": "0.8.0",
  "description": "Maintainer build requirements and pinned build/runtime inputs. IDE and Rust-worker build tools are installed on the maintainer machine, not bundled with the source checkout or prebuilt application. Separate pruned/app-local compiler backends are product runtime dependencies shipped so users can compile RBL programs on a clean PC.",
  "output_layout": {
    "cache_root": "build/cache",
    "compiled_program_cache": "build/cache/sources",
    "downloaded_sources": "build/cache/<component>",
    "build_outputs": "build/output",
    "environment_overrides": ["RBL_BUILD_DIR", "RBL_CACHE_DIR", "RBL_OUTPUT_DIR"]
  },
