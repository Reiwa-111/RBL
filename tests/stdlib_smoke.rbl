func main() (
    print("=== GLOBAL STDLIB ===")
    print(len("hello"))
    print(int("42"))
    print(float("3.5"))
    print(str(123))
    print(abs(-9))
    print(sqrt(81))
    print(min(7, 2, 5))
    print(max(7, 2, 5))
    print(pow(2, 8))
    print(floor(3.9))
    print(ceil(3.1))
    print(round(3.6))
    print(sin(0f))
    print(cos(0f))
    print(log(1f))
    print(exp(0f))
    print("=== IO / FS ===")
    write_file("/tmp/rbl_stdlib_test.txt", "RBL FILE OK")
    print(read_file("/tmp/rbl_stdlib_test.txt"))
    print(rbl.fs.exists("/tmp/rbl_stdlib_test.txt"))
    print(rbl.fs.delete("/tmp/rbl_stdlib_test.txt"))
    print(rbl.fs.exists("/tmp/rbl_stdlib_test.txt"))
    print("=== MATH ===")
    print(rbl.math.pow(2, 8))
    print(rbl.math.sqrt(81))
    print(rbl.math.floor(3.9))
    print(rbl.math.ceil(3.1))
    print(rbl.math.round(3.6))
    print("=== STRING ===")
    print(rbl.string.len("abcdef"))
    print(rbl.string.upper("hello RBL"))
    print(rbl.string.lower("HELLO RBL"))
    print(rbl.string.trim("   hello   "))
    print(rbl.string.contains("hello world", "world"))
    print(rbl.string.starts_with("hello world", "hello"))
    print(rbl.string.ends_with("hello world", "world"))
    print("=== TIME ===")
    print(rbl.time.now_ms() > 0)
    rbl.time.sleep_ms(1)
    print("=== RANDOM ===")
    print(rbl.random.int(1, 10))
    print(rbl.random.float())
    print(rbl.random.bool())
    print("=== PARENTHESIZED BLOCKS ===")
    set x = 2
    if (x == 2) (
        print("if works")
    ) else (
        print("if broken")
    )
    for (i in 0..=2) (
        print(i)
    )
    print("DONE")
)
