// Unified for: `for (cond)` runs while the condition is true, and `for (true)`
// loops until a break. break/continue work exactly as in the range form.
func main() (
    set i = 0
    for (i < 3) (
        print(i)
        let i += 1
    )
    print("after")

    set n = 0
    for (true) (
        let n += 1
        if (n == 4) ( break )
    )
    print(n)

    set k = 0
    for (k < 10) (
        let k += 1
        if (k % 2 == 0) ( continue )
        print(k)
    )
)
