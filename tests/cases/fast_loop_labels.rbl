// Regression: a fast integer loop whose body emits labels (the nested if) must
// not make the parent context reuse label ids. Before the fix this produced
// ".L_if_next_N is already defined" from GNU as even though the program is valid.
func main() (
    set s = 0
    for (i in 0..3) (
        if (i > 1) (
            let s = s + i
        )
    )
    if (s > 0) (
        print(s)
    )
)
