// Conditional expression `a if (cond) else b`. Only the taken branch is
// evaluated, so `risky()` below must never run.
func main() (
    set a = 10
    set b = 20
    print(a if (a > b) else b)
    print(a if (a < b) else b)
    print("yes" if (a < b) else "no")
    print((a + 1) if (true) else (b / 0))
    set n = 0
    print(1 if (n == 0) else 2)
    print(b if (n != 0) else a)
)
