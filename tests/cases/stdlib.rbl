func main() (
    print("=== STDLIB ===")
    print(len("Привет"))
    print(abs(-42))
    print(abs(25f))
    print(sqrt(81))
    print(min(9, 4, 7))
    print(max(9, 4, 7))
    print(int(129f))
    print(float(12))
    print(str(123))
    print(str(true))
    print(int("321"))
    print(float("3.25"))
    write_file("/tmp/rbl_stdlib_test.txt", "RBL stdlib works")
    print(read_file("/tmp/rbl_stdlib_test.txt"))
)
