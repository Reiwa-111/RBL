// Tuples and structs (RBL 0.8, phase 2.5).
// A struct instance is a dictionary with the declared field names as keys, so
// fields, printing and equality reuse the container runtime unchanged.
struct Point (
    x int
    y int
)

// Receiver method: `p.move(dx, dy)` is `move(p, dx, dy)`; the receiver is a
// dictionary, so the caller sees field changes (reference semantics).
func (p Point) move(dx int, dy int) (
    let p.x = p.x + dx
    let p.y = p.y + dy
)

func main() (
    set t = (1, 2, 3)
    print(t)
    print(len(t))
    print(t[0])
    print(t[2])

    set pair = (1, (2, 3))
    print(pair)
    print(pair[1][1])
    print((1, 2) == (1, 2))
    print((1, 2) == (1, 3))
    print(len(()))

    for (v in t) ( print(v) )

    set p = Point(3, 4)
    print(p)
    print(p.x)
    print(p.y)
    let p.x = 30
    print(p.x)
    print(len(p))
    print("x" in p)

    print(p == Point(30, 4))
    print(p == Point(1, 1))

    p.move(5, 6)
    print(p.x)
    print(p.y)
    print(p)
)
